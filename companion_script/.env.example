# ============================================================
# DubeyAI Companion Script — Environment Variables
# Copy this file to .env (same folder) and fill in real values.
# NEVER commit the actual .env to version control.
# ============================================================

# "production" -> https://dubeyai.adityadubey.co.in (the live Vercel deployment)
# "local"      -> http://127.0.0.1:8000 (a Django dev server on this machine)
DUBEYAI_ENV=production

# Only needed if neither preset above fits (e.g. a staging URL).
# DUBEYAI_API_BASE_URL=https://staging.example.com

# Must match COMPANION_API_KEY in the Django backend's .env / Vercel env vars.
DUBEYAI_API_KEY=

# ── Timing (seconds) ─────────────────────────────────────────
POLL_INTERVAL_SECONDS=3
REQUEST_TIMEOUT_SECONDS=10
REMINDER_TOLERANCE_SECONDS=30

# ── Logging ──────────────────────────────────────────────────
LOG_FILE=companion.log

# ── Alarm sound (optional) ───────────────────────────────────
# Path (relative to this folder) to a .wav/.mp3 to play when a reminder
# fires. Leave blank to skip sound and rely on the desktop notification alone.
ALARM_SOUND_FILE=
