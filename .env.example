# ============================================================
# DubeyAI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env to version control.
# ============================================================

# ── Django core ──────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=replace-with-a-long-random-secret-key

DEBUG=True

# Comma-separated. Add your Render hostname without https://
ALLOWED_HOSTS=127.0.0.1,localhost

# Required on Render (https://your-app.onrender.com)
CSRF_TRUSTED_ORIGINS=

TIME_ZONE=Asia/Kolkata
SECURE_SSL_REDIRECT=False
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────
# DB_ENV=local  -> SQLite (default, no other DB_* vars needed)
# DB_ENV=production -> Neon/PostgreSQL via NEON_DATABASE_URL
DB_ENV=local
NEON_DATABASE_URL=

# Render auto-sets DATABASE_URL for its own PostgreSQL add-on; when present it
# takes priority over DB_ENV/NEON_DATABASE_URL (existing deployment behavior).
# Leave blank locally to use SQLite.
DATABASE_URL=

# ── NVIDIA API (default active AIProvider) ──────────────────
# Get your key from: https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_TIMEOUT_SECONDS=90
NVIDIA_MAX_TOKENS=4096

# ── Chat limits ──────────────────────────────────────────────
CHAT_MAX_MESSAGE_LENGTH=12000
CHAT_HISTORY_LIMIT=50

# ── core app ─────────────────────────────────────────────────
# Encrypts AIProvider.api_key at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Static key the local companion script (Phase 5) sends as header X-DubeyAI-Key
COMPANION_API_KEY=

# ── Web Push (VAPID) ─────────────────────────────────────────
# Generate a key pair with: python manage.py generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@example.com

# ── Cloudinary (persistent media storage) ────────────────────
# REQUIRED IN PRODUCTION. Vercel's serverless filesystem is ephemeral, so
# uploaded PDFs/DOCX/images do not survive between requests without this.
#
# Where to find these:
#   1. Sign in at https://console.cloudinary.com/
#   2. Dashboard -> "Product Environment Credentials" (top of the page)
#   3. Copy the three values below. "API Secret" is hidden behind a reveal
#      button — treat it like a password, never commit it or expose it to JS.
#
# If these are LEFT EMPTY, the app falls back to local MEDIA_ROOT storage.
# That is correct for local development and for running the test suite; it is
# NOT safe for production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: folder that all DubeyAI uploads are namespaced under in Cloudinary.
CLOUDINARY_FOLDER=dubeyai
